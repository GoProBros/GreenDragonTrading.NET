# Environment Variables Template
# Copy this file to .env and fill in your values

# Google Drive Configuration
# Copy entire content of your service account JSON file here (as single line or multiline)
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Database Connection
GdtPostgreSqlConnection=Host=localhost;Port=5432;Database=greendragontrading_v1;Username=postgres;Password=your_password

# Redis Connection
Redis=localhost:6379,password=your_redis_password

# JWT Configuration
JwtOptions__Secret=your-very-long-secret-key-here-minimum-32-characters
JwtOptions__Issuer=GreenDragonTradingAPI
JwtOptions__Audience=GreenDragonTradingClient

# Email Configuration (SMTP)
EmailOptions__SmtpServer=smtp.gmail.com
EmailOptions__SmtpPort=587
EmailOptions__SenderEmail=your-email@gmail.com
EmailOptions__SenderName=Green Dragon Trading
EmailOptions__Username=your-email@gmail.com
EmailOptions__Password=your-app-password

# SSI API V2 Credentials
SsiApiV2__ConsumerID=your-consumer-id
SsiApiV2__ConsumerSecret=your-consumer-secret
SsiApiV2__PrivateKey=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
SsiApiV2__PublicKey=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# AWS S3 / Cloudflare R2 (if using)
AWS__Credentials__AccessKeyId=your-access-key
AWS__Credentials__SecretAccessKey=your-secret-key
R2Options__Endpoint=https://your-account-id.r2.cloudflarestorage.com
R2Options__BucketName=your-bucket-name
