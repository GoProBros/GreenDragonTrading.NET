# Database Configuration
DATABASE_HOST=your_database_host
DATABASE_NAME=your_database_name
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

# Redis Configuration
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# SSI API V1 Configuration
SSI_V1_IBOARD_QUERY=https://iboard-query.ssi.com.vn
SSI_V1_IBOARD_API=https://iboard-api.ssi.com.vn
SSI_V1_TIMEOUT_SECONDS=30

# SSI API V2 Configuration
SSI_V2_FASTCONNECT_URL=https://fc-data.ssi.com.vn
SSI_V2_STREAM_URL=https://fc-datahub.ssi.com.vn
SSI_V2_CONSUMER_ID=your_consumer_id
SSI_V2_CONSUMER_SECRET=your_consumer_secret
SSI_V2_PUBLIC_KEY=your_public_key
SSI_V2_PRIVATE_KEY=your_private_key
SSI_V2_TIMEOUT_SECONDS=30

# CORS Configuration (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:5173,https://localhost:5173

# App Settings
APP_BASE_URL=http://localhost:5146

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_ISSUER=GreenDragonTrading
JWT_AUDIENCE=GreenDragonTradingUsers
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Email Configuration
EMAIL_SMTP_HOST=smtp.sendgrid.net
EMAIL_SMTP_PORT=587
EMAIL_SENDER_EMAIL=your_sender_email
EMAIL_SENDER_NAME=Your Sender Name
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=your_sendgrid_api_key
EMAIL_ENABLE_SSL=true

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your_account_id.r2.cloudflarestorage.com

# AWS Credentials for R2
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
